# =============================================================================
# hr-talent-evaluator  --  environment configuration
# Copy to `.env` and fill in. NEVER commit the populated file.
# Every value below is optional: with none of them set the agent boots in
# OFFLINE mode (deterministic local embedder + in-process vector index + mock
# cognition/synthesis), which is what the test suite and `make demo` exercise.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
HRTE_ENV=development                 # development | staging | production
HRTE_LOG_LEVEL=INFO

# ---- Latency governance -----------------------------------------------------
# Hard ceiling for "candidate stops speaking" -> "first agent audio byte out".
HRTE_LATENCY_BUDGET_MS=160
# Silence window that commits a turn. Lower = snappier, higher = fewer barge-ins.
HRTE_ENDPOINT_SILENCE_MS=250
# Speculative generation starts this early into the silence window. The turn is
# discarded for free if the candidate resumes speaking before commit.
HRTE_SPECULATIVE_SILENCE_MS=120
# Sustained speech energy during agent playback that triggers a barge-in abort.
HRTE_BARGE_IN_MS=30

# ---- LiveKit WebRTC ---------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HRTE_ROOM_PREFIX=screening

# ---- Cognition (Google GenAI) ----------------------------------------------
GOOGLE_API_KEY=
HRTE_COGNITION_MODEL=gemini-2.0-flash
HRTE_COGNITION_TEMPERATURE=0.2
HRTE_COGNITION_MAX_TOKENS=150

# ---- Speech-to-speech synthesis --------------------------------------------
# NOTE: "moss" here means MOSS-Speech, the open speech-to-speech MODEL.
# It is unrelated to Moss (YC F25), the retrieval runtime configured below.
HRTE_SPEECH_ENGINE=mock              # mock | moss | livekit
HRTE_SPEECH_WS_URL=
HRTE_SPEECH_API_KEY=

# ---- Moss retrieval runtime (HOT PATH) -------------------------------------
# Moss (YC F25) serves rubric retrieval in under 10ms, in-process, with no
# vector database and no network hop. This is the 10ms VECTOR_MATCH line item
# in the latency budget. Leave empty to use the embedded fallback index.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
HRTE_MOSS_INDEX=engineering_talent_rubrics

# ---- Qdrant (COLD ARCHIVE, optional) ---------------------------------------
# Durable storage for completed evaluations. Never on the conversational hot
# path. Leave empty to keep dossiers in the in-process index only.
QDRANT_URL=
QDRANT_API_KEY=
HRTE_QDRANT_COLLECTION=engineering_talent_rubrics

# ---- Telemetry (Langfuse + OTel) -------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Speech-to-text (Candidate App voice input) -----------------------------
# Real transcription via Deepgram's prerecorded REST endpoint. Leave empty and
# the API returns a clearly-labelled offline placeholder; the Candidate App
# falls back to typed answers automatically (see app/voice/stt_engine.py).
DEEPGRAM_API_KEY=

# ---- Primary DB (API Gateway: sessions, turns, evaluations) ----------------
# Empty = SQLite file under HRTE_DATA_DIR (./data by default). Point this at
# Postgres in production, e.g.:
#   postgresql+psycopg://hrte:password@postgres:5432/hrte
DATABASE_URL=
HRTE_DATA_DIR=./data

# ---- Session State (optional; in-process without it) -----------------------
# Mirrors live-session status (not the orchestrator itself, which cannot be
# serialized) to Redis so an admin dashboard on another replica can see it.
# Absence just means "session state is process-local", not a startup failure.
REDIS_URL=

# ---- API Gateway ------------------------------------------------------------
# Comma-separated list of allowed origins for the Candidate App / Admin
# Dashboard, or "*" for local development. Never "*" with real candidate data.
HRTE_CORS_ORIGINS=*
HRTE_SESSION_TTL_SECONDS=3600
# Minimum viable guard on the /api/admin/* routes (see app/api/routes_admin.py).
# Leave unset for local/dev; set it before exposing the admin API beyond a
# trusted network. Sent by the Admin Dashboard as the X-Admin-Token header.
HRTE_ADMIN_TOKEN=

# ---- Security ---------------------------------------------------------------
# strict: any PII reaching an egress boundary raises SecurityBreachException.
# permissive: scrub + emit a telemetry counter instead of raising.
HRTE_PII_MODE=strict

# Keying material for redaction fingerprints. Every redacted identifier is
# reduced to a keyed BLAKE2b digest, so duplicate applications are detectable
# without anything reversible being stored.
#
# SET THIS IN PRODUCTION. When unset, an ephemeral per-process key is generated:
# fingerprints then stop linking across restarts, which is the safe failure.
# The unsafe alternative -- a constant default -- would make fingerprints
# guessable, since a 10-digit phone number is only 10^10 candidates and an
# unkeyed digest of one IS the number.
HRTE_REDACTION_KEY=
