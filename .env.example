# =============================================================================
# hr-talent-evaluator  --  environment configuration
# Copy to `.env` and fill in. NEVER commit the populated file.
#
# Every value below is optional. With none of them set the app boots in
# OFFLINE mode: a deterministic mock analyst and a local SQLite file. That is
# what the test suite and `make demo` exercise, and it is a real working
# product -- just one that scores records by how much detail they carry
# rather than by judgement, and says so in every rationale.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
HRTE_ENV=development                 # development | staging | production

# ---- The analyst (Google GenAI) ---------------------------------------------
# The one credential that changes the product. Without it the dashboard shows
# "Offline analyst" and the chat says it cannot really analyse the pool.
# Get one at https://aistudio.google.com/apikey -- the free tier is enough.
GOOGLE_API_KEY=

# A floating alias by default: pinned versions get retired (gemini-2.0-flash
# and gemini-2.5-flash both have been), and when one does, every call 400s and
# the app silently falls back to the mock. /api/status reports that as
# `degraded` so it cannot go unnoticed, but an alias avoids it entirely.
HRTE_MODEL=gemini-flash-latest

# Ranking wants consistency, not flair.
HRTE_TEMPERATURE=0.4

# Enough room for one rationale per candidate across a whole pool.
HRTE_MAX_OUTPUT_TOKENS=2048

# Thinking tokens are billed out of MAX_OUTPUT_TOKENS. At 0 the model answers
# directly. Raise it (512+) for harder pools, but raise MAX_OUTPUT_TOKENS too
# or the model can spend its whole allowance reasoning and return an empty
# string with finishReason MAX_TOKENS. Leave it unset entirely to omit the
# field, for a model that rejects it.
HRTE_THINKING_BUDGET=0

# ---- Storage ----------------------------------------------------------------
# Unset means a local SQLite file under ./data. Point this at Postgres for a
# real deployment.
DATABASE_URL=

# ---- Access -----------------------------------------------------------------
# Set this and every /api route requires an `X-Admin-Token` header matching
# it. Unset leaves the API open, which is fine locally and is not fine on a
# public URL: the pool contains candidate records.
HRTE_ADMIN_TOKEN=

# Comma-separated origins, or `*`. Credentials are only allowed when this is
# an explicit list.
HRTE_CORS_ORIGINS=*

# ---- PII --------------------------------------------------------------------
# strict redacts every identifier the scrubber recognises on the way in.
HRTE_PII_MODE=strict

# Keyed fingerprints let you tell "same person, two records apart" without
# storing the identifier. Unset means an ephemeral per-process key, so
# fingerprints do not survive a restart.
HRTE_REDACTION_KEY=
